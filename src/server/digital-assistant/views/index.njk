{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="POST" action="/digital-assistant/submit">
        {{ govukTextarea({
          name: "prompt",
            id: "prompt",
            value: promptValue if promptValue else '',
            label: {
                text: "Ask Agent",
                classes: "govuk-label--l",
                isPageHeading: true
            },
            hint: {
                text: "Ask about the Service Manual, AI Toolkit, or Delivery Groups…"
            }
        }) }}
        {{ govukButton({
            text: "Submit"
        }) }}
      </form>
      <section class="govuk-!-margin-top-6" id="response-section" {% if not responseMessage %}hidden{% endif %} aria-live="polite">
        <h2 class="govuk-heading-m">Response</h2>
        <textarea class="govuk-textarea" id="response-area" rows="12" readonly>{{ responseMessage if responseMessage else '' }}</textarea>
      </section>      
    </div>
  </div>
{% endblock %}